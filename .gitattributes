# Keep bundled Python hashes identical across checkouts.
*.py text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Inventories record exact export/snapshot bytes across Git checkouts.
*/*_roadmap.* -text -whitespace
*/manifest.json -text -whitespace
*/files.sha256.json -text -whitespace
*/README.md -text -whitespace
*/source/** -text -whitespace

